# Google Gemini API Key (可从 Google AI Studio 获取)
GEMINI_API_KEY=

# 服务监听端口 (默认 3000)
PORT=3000

# 默认使用的 Gemini 模型
DEFAULT_MODEL=gemini-2.5-flash

# HTTP / HTTPS 正向代理（国内网络环境访问 Gemini API 必备）
HTTPS_PROXY=http://127.0.0.1:7890
HTTP_PROXY=http://127.0.0.1:7890

# 工作区根目录（默认自动向上查找 GEMINI.md / .agents / .git）
# WORKSPACE_ROOT=/Users/hexianghong/code/ai-standards
